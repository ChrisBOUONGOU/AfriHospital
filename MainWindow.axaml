<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AfriHospital.MainWindow"
        Title="AfriHospital"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="620"
        Background="{DynamicResource PageBackground}">
  <Grid ColumnDefinitions="240,*">
    <Border Grid.Column="0" Background="{DynamicResource BrandBlack}" Padding="20">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="22">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,20">
            <Border Background="{DynamicResource BrandGreen}" CornerRadius="10" Width="42" Height="42">
              <TextBlock Text="+" FontSize="32" FontWeight="Bold" Foreground="#171717"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="AfriHospital" FontSize="19" FontWeight="Bold" Foreground="White" />
              <TextBlock Text="GESTION HOSPITALIÈRE" FontSize="9" Foreground="#C5C5C5" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="MENU PRINCIPAL" Foreground="#A3A3A3" FontSize="11" FontWeight="Bold" />
          <Button Content="▦   Tableau de bord" HorizontalContentAlignment="Left" Background="{DynamicResource BrandGreen}" Foreground="#171717" FontWeight="Bold" Padding="14,12" CornerRadius="8" />
          <Button Content="♙   Patients" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="14,12" />
          <Button Content="✚   Consultations" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="14,12" />
          <Button Content="▣   Rendez-vous" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="14,12" />
          <Button Content="▤   Pharmacie" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="14,12" />
          <Button Content="₣   Facturation" HorizontalContentAlignment="Left" Background="Transparent" Foreground="White" Padding="14,12" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#292929" CornerRadius="10" Padding="12" Margin="0,20,0,0">
          <StackPanel Spacing="4">
            <TextBlock Text="AfriHospital" Foreground="White" FontWeight="SemiBold" />
            <TextBlock Text="Prototype · Étape 1" Foreground="#C5C5C5" FontSize="11" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="30" Spacing="24">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="5">
            <TextBlock Text="Tableau de bord" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource BrandBlack}" />
            <TextBlock Text="Vue d’ensemble de l’activité de l’établissement" Foreground="{DynamicResource MutedText}" FontSize="14" />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource BrandYellow}" CornerRadius="9" Padding="16,10" VerticalAlignment="Center">
            <TextBlock Text="●  Démonstration" Foreground="#242000" FontWeight="SemiBold" />
          </Border>
        </Grid>
        <Border Background="{DynamicResource BrandGreen}" CornerRadius="14" Padding="22">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="8">
              <TextBlock Text="Bienvenue sur AfriHospital" FontSize="23" FontWeight="Bold" Foreground="#17220F" />
              <TextBlock Text="Une gestion plus simple des soins et des activités hospitalières." TextWrapping="Wrap" Foreground="#26351D" FontSize="14" />
              <TextBlock Text="Les chiffres ci-dessous sont des exemples fictifs." Foreground="#26351D" FontSize="12" />
            </StackPanel>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Width="68" Height="68" VerticalAlignment="Center">
              <TextBlock Text="✚" FontSize="42" Foreground="#171717" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Border>
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
          <Border Background="White" CornerRadius="12" Padding="17" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Spacing="10"><TextBlock Text="PATIENTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedText}" /><TextBlock Text="128" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource BrandBlack}" /><TextBlock Text="Exemple fictif" FontSize="11" Foreground="{DynamicResource MutedText}" /></StackPanel>
          </Border>
          <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="17" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Spacing="10"><TextBlock Text="CONSULTATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedText}" /><TextBlock Text="24" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource BrandBlack}" /><TextBlock Text="Aujourd’hui · démo" FontSize="11" Foreground="{DynamicResource MutedText}" /></StackPanel>
          </Border>
          <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="17" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Spacing="10"><TextBlock Text="RENDEZ-VOUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedText}" /><TextBlock Text="12" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource BrandBlack}" /><TextBlock Text="À venir · démo" FontSize="11" Foreground="{DynamicResource MutedText}" /></StackPanel>
          </Border>
          <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="17" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Spacing="10"><TextBlock Text="ALERTES STOCK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedText}" /><TextBlock Text="3" FontSize="30" FontWeight="Bold" Foreground="#9A6700" /><TextBlock Text="À vérifier · démo" FontSize="11" Foreground="{DynamicResource MutedText}" /></StackPanel>
          </Border>
        </Grid>
        <Grid ColumnDefinitions="1.35*,*" ColumnSpacing="18">
          <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Spacing="16">
              <TextBlock Text="Activité du jour" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrandBlack}" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                <TextBlock Text="Patients enregistrés" Foreground="#374151" /><TextBlock Grid.Column="1" Text="08" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Text="Consultations réalisées" Foreground="#374151" /><TextBlock Grid.Row="1" Grid.Column="1" Text="24" FontWeight="Bold" />
                <TextBlock Grid.Row="2" Text="Rendez-vous restants" Foreground="#374151" /><TextBlock Grid.Row="2" Grid.Column="1" Text="12" FontWeight="Bold" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Spacing="14">
              <TextBlock Text="Alertes à suivre" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrandBlack}" />
              <Border Background="#FFF7D6" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Stock de médicaments" FontWeight="SemiBold" Foreground="#5B4300" /><TextBlock Text="3 articles nécessitent une vérification." TextWrapping="Wrap" FontSize="12" Foreground="#5B4300" /></StackPanel></Border>
              <Border Background="#F3F4F6" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Prochaine étape" FontWeight="SemiBold" Foreground="#171717" /><TextBlock Text="Connecter les données réelles et les patients." TextWrapping="Wrap" FontSize="12" Foreground="#4B5563" /></StackPanel></Border>
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Text="AfriHospital · Prototype d’interface — ne pas utiliser pour des décisions médicales réelles." FontSize="11" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
