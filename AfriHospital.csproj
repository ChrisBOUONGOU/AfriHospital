<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="src\Api\Controllers\" />
    <Folder Include="src\Api\Middleware\" />
    <Folder Include="src\Application\DTOs\" />
    <Folder Include="src\Application\Validators\" />
    <Folder Include="src\Application\Services\" />
    <Folder Include="src\Desktop\Assets\" />
    <Folder Include="src\Desktop\ViewModels\" />
    <Folder Include="src\Desktop\Views\" />
    <Folder Include="src\Domain\Enums\" />
    <Folder Include="src\Domain\Interfaces\" />
    <Folder Include="src\Infrastructure\Security\" />
    <Folder Include="src\Infrastructure\Repositories\" />
    <Folder Include="src\Infrastructure\Persistence\" />
    <Folder Include="test\IntergrationTests\" />
    <Folder Include="test\UnitTests\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
