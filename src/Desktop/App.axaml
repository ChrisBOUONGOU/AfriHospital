<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AfriHospital.src.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <SolidColorBrush x:Key="BrandGreen" Color="#A8E66B" />
    <SolidColorBrush x:Key="BrandYellow" Color="#FFD43B" />
    <SolidColorBrush x:Key="BrandBlack" Color="#171717" />
    <SolidColorBrush x:Key="PageBackground" Color="#F5F7F2" />
    <SolidColorBrush x:Key="MutedText" Color="#6B7280" />
  </Application.Resources>
</Application>
